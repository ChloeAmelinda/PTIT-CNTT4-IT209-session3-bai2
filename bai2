server {
    listen 80;
    listen [::]:80;

    server_name _;

    root /var/www/my-web/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Custom 404 error page
    error_page 404 /404.html;

    # Prevent direct access to /404.html
    location = /404.html {
        root /var/www/my-web/html;
        internal;
    }
}
